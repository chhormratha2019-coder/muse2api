# /etc/muse2api.env  (chmod 600)
# Isolated instance: binds loopback only; Cloudflare Tunnel reaches localhost:6391.
MUSE2API_HOME=/opt/muse2api
MUSE2API_HOST=127.0.0.1
MUSE2API_PORT=6391

# Generate with: echo "m2a_$(openssl rand -hex 24)"
MUSE2API_KEY=m2a_replace_with_openssl_rand_hex_24

MUSE2API_CHROMIUM=/usr/bin/google-chrome
MUSE2API_CDP_PORT=19211
MUSE2API_PROFILE_ROOT=/opt/muse2api/home/muse2api-profiles
MUSE2API_HOME_DIR=/opt/muse2api/home

MUSE2API_CONCURRENCY=1
MUSE2API_IMAGE_TIMEOUT=300
MUSE2API_VIDEO_TIMEOUT=900
MUSE2API_CHAT_TIMEOUT=300

# Keep both disabled unless you have reviewed the upstream target.
MUSE2API_UPDATER_ENABLED=0
MUSE2API_ALLOW_WEB_PUSH=0

PYTHONDONTWRITEBYTECODE=1
